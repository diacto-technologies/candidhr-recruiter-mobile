# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'candidhr' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Xcode 27 only supports IPHONEOS_DEPLOYMENT_TARGET 15.0–27.0.
    # Resource-bundle pod targets often keep older values (8.0–13.4).
    min_ios = '15.1'
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |build_config|
        current = build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
        if current.nil? || Gem::Version.new(current.to_s) < Gem::Version.new(min_ios)
          build_config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = min_ios
        end

        # Xcode 26.4+/27 Clang rejects fmt 11's C++20 consteval format strings.
        # Compile only fmt as C++17 so that path is disabled. Leave other pods on C++20.
        if target.name == 'fmt'
          build_config.build_settings['CLANG_CXX_LANGUAGE_STANDARD'] = 'c++17'
        end
      end
    end

    %w[debug release].each do |cfg|
      xcconfig_path = File.join(installer.sandbox.root, 'Target Support Files', 'fmt', "fmt.#{cfg}.xcconfig")
      next unless File.exist?(xcconfig_path)

      contents = File.read(xcconfig_path)
      patched = contents.gsub(/^\s*CLANG_CXX_LANGUAGE_STANDARD\s*=\s*.*$/, 'CLANG_CXX_LANGUAGE_STANDARD = c++17')
      File.write(xcconfig_path, patched) if patched != contents
    end
  end
end
